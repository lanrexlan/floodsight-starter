# Copy this file to .env and fill in your own credentials.
# Nothing here is required to run the synthetic demo (scripts/run_demo_pipeline.py)
# or the API/dashboard against the synthetic fallback grid.

# NASA Earthdata (for GPM IMERG rainfall — floodsight/download/rainfall_gpm.py)
# Free account: https://urs.earthdata.nasa.gov/users/new
NASA_EARTHDATA_USERNAME=cropsentinel
NASA_EARTHDATA_PASSWORD=5Rj3gQR3t$zf$8B

# Copernicus Early Warning Data Store (for GloFAS river discharge —
# floodsight/download/river_discharge.py). Note: cdsapi reads its key from
# ~/.cdsapirc by convention, not from this .env — see the docstring in
# river_discharge.py for the exact file format.
# Free account: https://ewds.climate.copernicus.eu/
CDS_API_KEY=

# Africa's Talking (for SMS alert dispatch — Phase 3 of ROADMAP.md, not
# yet wired into this scaffold, included here for when you build it)
# https://africastalking.com/
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
