# Copy this file to .env and fill in your own credentials.
# Nothing here is required to run the synthetic demo (scripts/run_demo_pipeline.py)
# or the API/dashboard against the synthetic fallback grid.

# NASA Earthdata (for GPM IMERG rainfall — floodsight/download/rainfall_gpm.py)
# Free account: https://urs.earthdata.nasa.gov/users/new
NASA_EARTHDATA_USERNAME=cropsentinel
NASA_EARTHDATA_PASSWORD=5Rj3gQR3t$zf$8B

# Copernicus Early Warning Data Store (for GloFAS river discharge —
# floodsight/download/river_discharge.py). Note: cdsapi reads its key from
# ~/.cdsapirc by convention, not from this .env — see the docstring in
# river_discharge.py for the exact file format.
# Free account: https://ewds.climate.copernicus.eu/
CDS_API_KEY=

# ── Phase 16: Resident SMS Alerts (Supabase + Africa's Talking) ───────────
# Required for /subscribe, /subscribers/count, and /alerts/dispatch endpoints.
# Without these the API still works, but those endpoints return 503.

# Supabase — free tier is fine for pilot scale
# Dashboard → Settings → API → Project URL and service_role key
# https://supabase.com/dashboard
SUPABASE_URL=https://buwwsplrhsfgnkulhkpc.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ1d3dzcGxyaHNmZ25rdWxoa3BjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Mjk0NjQ0MCwiZXhwIjoyMDk4NTIyNDQwfQ.eihdEvCKY12ArDkrw6IdOUiN0fbVQsbSLRTPOjkT4og

# Africa's Talking — direct connections to MTN, Airtel, Glo, 9mobile
# ~10× cheaper than Twilio for Nigeria. Use username='sandbox' for testing.
# Dashboard → Settings → API Key
# https://account.africastalking.com
AT_USERNAME=floodsight
AT_API_KEY=atsk_6270e6d9d764cc080665cc065ab808effd64ab4e8707c92fa4ba4550a6631732896ce1c7
AT_SENDER_ID=FloodSight

# Shared secret for POST /alerts/dispatch — keep this in Render AND in
# your cron-job.org request header: Authorization: Bearer <this value>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DISPATCH_SECRET=ffa65098ac0b5eddda4cb4a80087d18d
