# Copy this file to .env and fill in your own credentials.
# Nothing here is required to run the synthetic demo (scripts/run_demo_pipeline.py)
# or the API/dashboard against the synthetic fallback grid.

# NASA Earthdata (for GPM IMERG rainfall — floodsight/download/rainfall_gpm.py)
# Free account: https://urs.earthdata.nasa.gov/users/new
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Copernicus Early Warning Data Store (for GloFAS river discharge —
# floodsight/download/river_discharge.py). Note: cdsapi reads its key from
# ~/.cdsapirc by convention, not from this .env — see the docstring in
# river_discharge.py for the exact file format.
# Free account: https://ewds.climate.copernicus.eu/
CDS_API_KEY=

# ── Phase 16: Resident SMS Alerts (Supabase + Africa's Talking) ───────────
# Required for /subscribe, /subscribers/count, and /alerts/dispatch endpoints.
# Without these the API still works, but those endpoints return 503.

# Supabase — free tier is fine for pilot scale
# Dashboard → Settings → API → Project URL and service_role key
# https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_KEY=

# Africa's Talking — direct connections to MTN, Airtel, Glo, 9mobile
# ~10× cheaper than Twilio for Nigeria. Use username='sandbox' for testing.
# Dashboard → Settings → API Key
# https://account.africastalking.com
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Shared secret for POST /alerts/dispatch — keep this in Render AND in
# your cron-job.org request header: Authorization: Bearer <this value>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DISPATCH_SECRET=

# REQUIRED. Shared secret for the two Africa's Talking callback webhooks:
#   POST /at/incoming?token=<this>   inbound SMS  (STOP replies, CHEW CONFIRM/REPORT)
#   POST /at/delivery?token=<this>   delivery reports
# Both endpoints fail CLOSED — if this is unset they return 503 for every
# callback, which means STOP replies are never honoured (an NDPR opt-out
# obligation) and CHEW responses are never recorded (loses the pilot's primary
# outcome data). The failure is silent from the outside, so GET /diagnostics
# reports it explicitly and startup logs it at ERROR.
# Set the SAME value here and in the AT dashboard callback URLs.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AT_WEBHOOK_TOKEN=

# Base URL of the deployed API, used by the scheduled scripts and workflows
# (morning briefing, health alerts, alert dispatch).
# Note: this replaced RENDER_EXTERNAL_URL, which was never actually set — code
# reading it silently received "" and fell back to broken defaults.
FLOODSIGHT_API=https://floodsight-starter.onrender.com

# Production requires real map data, database, explicit consent + phone proof,
# a restricted origin list, and confirmed provider agreements. See DEPLOYMENT.md.
FLOODSIGHT_ENV=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REQUIRE_OTP=false
ALERT_DISPATCH_ENABLED=false
ENABLE_EXPERIMENTAL_DEPTH=false
HEALTH_DISPATCH_ENABLED=false
DATA_PROVIDER_LICENSES_CONFIRMED=false
# Paid Open-Meteo endpoints use the customer host and apikey query parameter.
OPENMETEO_API_KEY=
# Optional field-partner token; falls back to DISPATCH_SECRET.
VERIFY_SECRET=
APPROVED_TEST_PHONES=
